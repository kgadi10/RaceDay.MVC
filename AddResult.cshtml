@model RaceDay.MVC.Models.ResultViewModel

<h2>Capture Participant Result</h2>

<form asp-action="AddResult" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EnrolmentId"></label>
        <input asp-for="EnrolmentId" type="number"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Position"></label>
        <input asp-for="Position" type="number"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FinishTime"></label>
        <input asp-for="FinishTime" class="form-control"
               placeholder="01:25:30" />
    </div>

    <button class="btn btn-primary">Save Result</button>
</form>