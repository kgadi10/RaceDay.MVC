@model RaceDay.MVC.Models.EventViewModel

<h2>Create Event</h2>

<form asp-action="CreateEvent" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Distance"></label>
        <input asp-for="Distance" type="number"
               step="0.1" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventType"></label>
        <select asp-for="EventType" class="form-select">
            <option>Run</option>
            <option>Walk</option>
            <option>Cycle</option>
        </select>
    </div>

    <button class="btn btn-primary">Save Event</button>
</form>