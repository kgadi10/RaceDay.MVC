@{
    ViewData["Title"] = "RaceDay";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold">RaceDay</h1>
    <h3>South Africa's Event Management Platform</h3>

    <p class="lead mt-3">
        Manage running, walking and cycling events.
        Register, enter events and view results.
    </p>

    <a asp-controller="Account" asp-action="Register"
       class="btn btn-primary btn-lg">Register</a>

    <a asp-controller="Account" asp-action="Login"
       class="btn btn-outline-primary btn-lg">Login</a>

    <a asp-controller="Participant" asp-action="Events"
       class="btn btn-secondary btn-lg">Browse Events</a>
</div>